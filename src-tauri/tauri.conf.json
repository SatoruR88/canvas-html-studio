{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas HTML Studio",
  "version": "0.1.1",
  "identifier": "studio.canvas.html",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Canvas HTML Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' blob: data: https:; media-src 'self' blob: data:; font-src 'self' blob: data:; style-src 'self' 'unsafe-inline' blob:; script-src 'self'; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "SatoruR88",
    "copyright": "Copyright (c) 2026 SatoruR88",
    "category": "DeveloperTool",
    "licenseFile": "../LICENSE.txt",
    "shortDescription": "HTMLを直接編集できるビジュアルエディター",
    "longDescription": "端末内のWebサイトやMarkdownを開き、HTMLとCSSを紙面のように直接編集できます。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
